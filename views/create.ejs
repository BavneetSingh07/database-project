<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/general.css">
  <link rel="stylesheet" href="/headerLoggedIn.css">
  <link rel="stylesheet" href="/create.css">
  <title>Create</title>
</head>
<body>
  <%- include('headerLoggedIn.ejs') %>
  <main>
    <div id="form-container">
      <form action = '/recipes/create' method = 'POST'>
        <div>
          <label>
            Name:
          </label>
          <input type = 'text' name = 'name' required>
        </div>
        <div id = 'description-container'>
          <label>
            Description:
          </label>
          <textarea id = 'description' name = 'description'></textarea>
        </div>
        <div id = 'ingredients-container'>
          <label>
            Ingredients:
          </label>
          <textarea id = 'ingredients' name = 'ingredients'></textarea>
        </div>
        <div id = 'instructions-container'>
          <label>
            Instructions:
          </label>
          <textarea id = 'instructions' name = 'instructions'></textarea>
        </div>
        <div>
          <label>
            Preparation Time (Minutes):
          </label>
          <input type = 'number' name = 'prep_time'>
        </div>
        <div>
          <label>
            Cooking Time (Minutes):
          </label>
          <input type = 'number' name = 'cooking_time'>
        </div>
        <div>
          <label>
            Total Servings:
          </label>
          <input type = 'number' name = 'total_servings'>
        </div>
        <div>
          <label>
            Calories:
          </label>
          <input type = 'number' name = 'calories'>
        </div>
        <div>
          <label>
            Protein:
          </label>
          <input type = 'number' name = 'protein' step = 0.01>
        </div>
        <div>
          <label>
            Carbohydrates:
          </label>
          <input type = 'number' name = 'carbohydrates' step = 0.01>
        </div>
        <div>
          <label>
            Fat:
          </label>
          <input type = 'number' name = 'fat' step = 0.01>
        </div>
        <div>
          <label>
            Favourite
          </label>
          <input type = 'hidden' name = 'favourite' value = 'no'>
          <input type = 'checkbox' name = 'favourite' value = 'yes'>
        </div>
        <div>
          <input type = 'submit' value = 'create' id = 'create'>
        </div>
      </form>
    </div>
  </main>
</body>
</html>