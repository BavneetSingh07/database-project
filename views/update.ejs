<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/general.css">
  <link rel="stylesheet" href="/headerLoggedIn.css">
  <link rel="stylesheet" href="/update.css">
  <title>Update</title>
</head>
<body>
  <%- include("headerLoggedIn.ejs") %>
  <main>
    <div id = 'form-container'>
      <form action = '/update' method = "POST">
        <div id ='firstname-container'>
          <label>
          First Name:
          </label>
          <input type = 'text' value = '<%=user.first_name%>' name = "first_name" maxlength="100">
        </div>
        <div id = 'lastnamecontainer'>
          <label>
            Last Name:
          </label>
          <input type = 'text' value = '<%=user.last_name%>' name = "last_name" maxlength="100">
        </div>
        <div id = 'dob-container'>
          <label>
            Date of Birth
         </label>
         <input type = 'date' value = '<%=user.date_of_birth%>' name = "date_of_birth">
        </div>
        <div id = 'email-container'>
          <label>
           Email:
         </label>
         <input type = 'text' value = '<%=user.email%>' name = "email" maxlength="100">
        </div>
        <div id = 'address-container'>
          <label>
            Address:
          </label>
          <input type = 'text' value = '<%=user.address%>' name = "address" maxlength="255">
        </div>
        <input type = 'submit'>
      </form>
    </div>
  </main>
</body>
</html>