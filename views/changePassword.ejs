<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/general.css">
  <link rel="stylesheet" href="/headerLoggedIn.css">
  <link rel="stylesheet" href="/changePassword.css">
  <title>Change Password</title>
</head>
<body>
  <%-include ("headerLoggedIn.ejs") %>
  <main>
    <div id = 'form-container'>
      <form action = '/changePassword' method = "POST">
        <div>
          <label>
            Old Password:
          </label>
          <input type = 'text' name = 'oldPassword' required>
        </div>
        <div>
          <label>
            New Password:
          </label>
          <input type = 'text' name = "newPassword" required pattern = "^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$">
          <div id = 'password-criteria-container'>
            <ul>
              <li>Minimum 8 Characters</li>
              <li>At least 1 Uppercase Letter</li>
              <li>At least 1 Lowercase Letter</li>
              <li>At least 1 Number</li>
              <li>At least 1 Special Character</li>
            </ul>
          </div>
        </div>
        <input type = 'submit'>
      </form>
    </div>
  </main>
</body>
</html>