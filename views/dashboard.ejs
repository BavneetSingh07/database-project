<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/general.css">
  <link rel="stylesheet" href="/headerLoggedIn.css">
  <link rel="stylesheet" href="/dashboard.css">
  <link rel="stylesheet" href="/alerts.css">
  <title>Dashboard</title>
</head>
<body>
  <%- include("headerLoggedIn.ejs") %>
  <%- include("alerts.ejs") %>
  <main>
    <a class = 'big-card' id = 'big-card-1' href = '/recipes/view'>
      <div id = 'recipe-count-title' class = 'big-card-title'>
        Recipes Count
      </div>
      <div id = 'recipe-count-image' class = 'big-card-image'>
        <img src = '/recipe.png'>
      </div>
      <div id = 'recipe-count-caption' class = 'big-card-caption'>
        <%=total_recipes%>
      </div>
    </a>
    
    <a class = 'big-card' id = 'big-card-2' href = '/favourites'>
      <div id = 'favourite-count-title' class = 'big-card-title'>
        Favourite Count
      </div>
      <div id = 'favourite-count-image' class = 'big-card-image'>
        <img src = '/star.png'>      
      </div>
      <div id = 'favourite-count-caption' class = 'big-card-caption'>
        <%=total_favourites%>
      </div>
    </a>

    <div class = 'small-card-container'>
      <a class = 'small-card' href = '/recipes/view'>
        <div class = 'small-card-image-container'>
          <img src="/calorie.png">
        </div>
        <div class = 'small-card-caption-container'>
          <div class = 'small-card-caption-title'>
            Total Calories In All Recipes
          </div>
          <div class = 'small-card-caption-content'>
            <% if (total_calories == null) { %>
              0
            <%} else {%>
              <%=total_calories%>
            <%}%>
          </div>
        </div>
      </a>
      <a class = 'small-card' href = '/recipes/view'>
        <div class = 'small-card-image-container'>
          <img src="/recipe.png">
        </div>
        <div class = 'small-card-caption-container'>
          <div class = 'small-card-caption-title'>
            Most Recent Recipe Added
          </div>
          <div class = 'small-card-caption-content' id = 'most-recent-recipe-container'>
            <ul>
              <li>
                Name:<% if (most_recent_recipe){ %>
                  <%=most_recent_recipe.name%>
                <%}%>
              </li>
              <% if (!most_recent_recipe || most_recent_recipe.calories == null) { %>
                <li>Calories: 0</li>
              <%} else {%>
                <li>Calories: <%=most_recent_recipe.calories%></li>
              <%}%>
              <% if (most_recent_recipe){%>
                <%if (most_recent_recipe.favourite == 1){%>
                  <li>Favourite: Yes</li>
                <%} else {%>
                  <li>Favourite:No</li>
                <%}%>
              <%}%>
            </ul>
          </div>
        </div>
      </a>
      <a class = 'small-card' href = '/account'>
        <div class = 'small-card-image-container'>
          <img src="/last-logged-in.png">
        </div>
        <div class = 'small-card-caption-container'>
          <div class = 'small-card-caption-title'>
            Last Logged In
          </div>
          <div class = 'small-card-caption-content'>
            <%=last_logged_in%>
          </div>
        </div>
      </a>
    </div>
  </main>
</body>
</html>