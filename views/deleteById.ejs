<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/general.css">
  <link rel="stylesheet" href="/headerLoggedIn.css">
  <link rel="stylesheet" href="/deleteById.css">
  <title>Delete Recipe</title>
</head>
<body>
  <%- include ("headerLoggedIn.ejs") %>
  <main>
    <div id = "confirmation-container">
      <form action = "/recipes/delete/<%=recipe_id%>" method = "POST">
        <div>
          <label>
            Confirm Deletion of Recipe '<%=name%>'
          </label>
        </div>
        <div id = "options">
          <div>
            <input type = 'radio' name = 'confirm' value = 'yes' required>
            <label>
              Yes
            </label>
          </div>
          <div>
            <input type = 'radio' name = 'confirm' value = 'no'>
            <label>
             No
            </label>
          </div>
        </div>
        <input type = 'submit'>
      </form>
    </div>
  </main>
</body>
</html>